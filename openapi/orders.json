{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Placing, listing and cancelling customer orders.",
    "title" : "Orders API",
    "version" : "1.4.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Relative to the host serving the API"
  } ],
  "paths" : {
    "/api/v1/orders" : {
      "get" : {
        "operationId" : "listOrders",
        "parameters" : [ {
          "in" : "query",
          "name" : "customerId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "PLACED", "SHIPPED", "CANCELLED" ]
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseOrderSummaryDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List orders, newest first",
        "tags" : [ "Orders" ]
      },
      "post" : {
        "description" : "Prices every line at the catalog's current price.",
        "operationId" : "createOrder",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Place an order",
        "tags" : [ "Orders" ]
      }
    },
    "/api/v1/orders/{id}" : {
      "get" : {
        "operationId" : "getOrder",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "Orders" ]
      }
    },
    "/api/v1/orders/{id}/cancel" : {
      "post" : {
        "description" : "Only orders that have not shipped can be cancelled.",
        "operationId" : "cancelOrder",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CancelOrderRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Cancel an order",
        "tags" : [ "Orders" ]
      }
    },
    "/api/v1/orders/{id}/ship" : {
      "post" : {
        "operationId" : "markShipped",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "Orders" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CancelOrderRequest" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        }
      },
      "CreateOrderRequest" : {
        "type" : "object",
        "properties" : {
          "customerId" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "lines" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OrderLineRequest"
            },
            "maxItems" : 50,
            "minItems" : 0
          }
        },
        "required" : [ "customerId", "lines" ]
      },
      "OrderLineRequest" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 999,
            "minimum" : 1
          }
        },
        "required" : [ "productId" ]
      },
      "OrderLineResponse" : {
        "type" : "object",
        "properties" : {
          "lineTotal" : {
            "type" : "number"
          },
          "productId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "productName" : {
            "type" : "string"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unitPrice" : {
            "type" : "number"
          }
        }
      },
      "OrderResponse" : {
        "type" : "object",
        "properties" : {
          "cancellationReason" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "currency" : {
            "type" : "string"
          },
          "customerId" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "lines" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OrderLineResponse"
            }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PLACED", "SHIPPED", "CANCELLED" ]
          },
          "totalAmount" : {
            "type" : "number"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "OrderSummaryDto" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "currency" : {
            "type" : "string"
          },
          "customerId" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "itemCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PLACED", "SHIPPED", "CANCELLED" ]
          },
          "totalAmount" : {
            "type" : "number"
          }
        }
      },
      "PageResponseOrderSummaryDto" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OrderSummaryDto"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    }
  }
}
